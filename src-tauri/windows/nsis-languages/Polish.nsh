; Tauri custom NSIS strings for Polish (LANG_POLISH).
; Used via bundle.windows.nsis.customLanguageFiles to silence the
; "Custom tauri messages for Polish are not translated" warning.
; Stock NSIS Polish UI strings still come from the NSIS language pack.

LangString addOrReinstall ${LANG_POLISH} "Dodaj/zainstaluj ponownie komponenty"
LangString alreadyInstalled ${LANG_POLISH} "Już zainstalowano"
LangString alreadyInstalledLong ${LANG_POLISH} "${PRODUCTNAME} ${VERSION} jest już zainstalowane. Wybierz operację i kliknij Dalej, aby kontynuować."
LangString appRunning ${LANG_POLISH} "{{product_name}} jest uruchomione! Zamknij je, a następnie spróbuj ponownie."
LangString noPermissionToCloseApp ${LANG_POLISH} "Brak uprawnień do zamknięcia {{product_name}}. Zamknij aplikację i spróbuj ponownie."
LangString appRunningOkKill ${LANG_POLISH} "{{product_name}} jest uruchomione!$\nKliknij OK, aby je zakończyć."
LangString chooseMaintenanceOption ${LANG_POLISH} "Wybierz opcję konserwacji do wykonania."
LangString chooseHowToInstall ${LANG_POLISH} "Wybierz sposób instalacji ${PRODUCTNAME}."
LangString createDesktop ${LANG_POLISH} "Utwórz skrót na pulpicie"
LangString dontUninstall ${LANG_POLISH} "Nie odinstalowuj"
LangString dontUninstallDowngrade ${LANG_POLISH} "Nie odinstalowuj (ten instalator nie pozwala na obniżenie wersji bez odinstalowania)"
LangString failedToKillApp ${LANG_POLISH} "Nie udało się zakończyć {{product_name}}. Zamknij je, a następnie spróbuj ponownie."
LangString installingWebview2 ${LANG_POLISH} "Instalowanie WebView2..."
LangString newerVersionInstalled ${LANG_POLISH} "Nowsza wersja ${PRODUCTNAME} jest już zainstalowana! Nie zaleca się instalacji starszej wersji. Jeśli naprawdę chcesz to zrobić, lepiej najpierw odinstalować bieżącą. Wybierz operację i kliknij Dalej, aby kontynuować."
LangString older ${LANG_POLISH} "starsza"
LangString olderOrUnknownVersionInstalled ${LANG_POLISH} "Na systemie jest zainstalowana wersja $R4 aplikacji ${PRODUCTNAME}. Zalecane jest odinstalowanie bieżącej wersji przed instalacją. Wybierz operację i kliknij Dalej, aby kontynuować."
LangString silentDowngrades ${LANG_POLISH} "Obniżanie wersji jest wyłączone dla tego instalatora — cicha instalacja nie może kontynuować. Użyj graficznego instalatora.$\n"
LangString unableToUninstall ${LANG_POLISH} "Nie można odinstalować!"
LangString uninstallApp ${LANG_POLISH} "Odinstaluj ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_POLISH} "Odinstaluj przed instalacją"
LangString unknown ${LANG_POLISH} "nieznana"
LangString webview2AbortError ${LANG_POLISH} "Nie udało się zainstalować WebView2! Aplikacja nie może działać bez niego. Spróbuj uruchomić instalator ponownie."
LangString webview2DownloadError ${LANG_POLISH} "Błąd: pobieranie WebView2 nie powiodło się — $0"
LangString webview2DownloadSuccess ${LANG_POLISH} "Bootstrapper WebView2 pobrano pomyślnie"
LangString webview2Downloading ${LANG_POLISH} "Pobieranie bootstrapa WebView2..."
LangString webview2InstallError ${LANG_POLISH} "Błąd: instalacja WebView2 zakończyła się kodem $1"
LangString webview2InstallSuccess ${LANG_POLISH} "WebView2 zainstalowano pomyślnie"
LangString deleteAppData ${LANG_POLISH} "Usuń dane aplikacji"
