{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main ESP32 Display Studio window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-serial",
    "allow-pc-agent",
    "allow-flash",
    "updater:default",
    "process:default",
    "dialog:default",
    "deep-link:default"
  ]
}
