{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ESP32 Display Studio",
  "version": "../package.json",
  "identifier": "studio.esp32.display",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ESP32 Display Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "ESP32 Display Studio",
      "showMenuOnLeftClick": true
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3RkExOUJDRjAwRTg3MkEKUldRcWh3N3d2Qm42WjhjdlNjVWlYUEoyUXlQd2Jzd2tNOFBYOUtKTk92TWJETDg3QzJBY0VBTGQK",
      "endpoints": [
        "https://github.com/mateowoj-cpu/ESP32-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["esp32studio"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "ESP32 Display Studio",
    "homepage": "https://github.com/mateowoj-cpu/ESP32-App",
    "category": "DeveloperTool",
    "copyright": "Copyright (C) 2026 ESP32 Display Studio",
    "shortDescription": "Visual environment for designing OLED/LCD interfaces for ESP32",
    "longDescription": "Visual environment for designing OLED/LCD interfaces for ESP32: hardware simulator, UI editor, automations, USB COM detection, PC agent, esptool flashing, and OTA/update tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["esp32studio"],
        "name": "ESP32StudioProject",
        "description": "ESP32 Display Studio project",
        "role": "Editor",
        "mimeType": "application/vnd.esp32studio+json"
      },
      {
        "ext": ["ino"],
        "name": "ArduinoSketch",
        "description": "Arduino sketch preview in ESP32 Display Studio",
        "role": "Viewer",
        "mimeType": "text/x-arduino"
      }
    ],
    "resources": [
      "resources/sidecar/README.txt",
      "resources/sidecar/**/*"
    ]
  }
}
